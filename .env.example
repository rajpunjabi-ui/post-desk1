# Password to log in to Post Desk
ADMIN_PASSWORD=choose-a-strong-password
# Any long random string (keeps you logged in safely)
SECRET_KEY=paste-a-long-random-string-here
# The public https address of this website, no slash at the end
PUBLIC_BASE_URL=https://your-app.up.railway.app
# From your Meta app > Instagram > API setup with Instagram login
# (the INSTAGRAM app ID and secret, not the main Meta App ID)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Times you type in the site are in this timezone
TIMEZONE=Asia/Kolkata
# Where the database and uploaded media are stored (a persistent volume)
DATA_DIR=/data
